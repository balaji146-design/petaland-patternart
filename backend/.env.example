PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://username:password@localhost:5432/petaland_patternart
DATABASE_SSL=false

JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=7d

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=petaland-patternart

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
ADMIN_EMAIL=admin@petalandpatternart.com

FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Optional comma-separated additional origins for deployed preview/admin apps.
CORS_ORIGINS=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200